package org.citadel.views.console;

public class SpecialMoveView {

    
    public void displayPromotionPrompt() {
        System.out.println("Promotion! Choose a piece to promote to (Q, R, B, N):");
    }

    public String getPromotionChoice() {
        // In a real console application, you would read user input here.
        // For now, we'll return a default or mock value.
        return System.console().readLine().toUpperCase();
    }

    public void displayInvalidPromotionChoice() {
        System.out.println("Invalid choice. Please choose from Q, R, B, N.");
    }
}
